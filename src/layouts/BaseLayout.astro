---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getAlternateLocales, localeMeta } from '../i18n/utils';
import { ENABLED_LOCALES, BANNER_COPY } from '../i18n/geo';
import JsonLd from '../components/seo/JsonLd.astro';
import { organizationNode } from '../lib/schema';
import { SITE } from '../lib/site';

// Self-host Inter font for 100/100 PageSpeed Insights score
import '@fontsource-variable/inter';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Alt text for the social image. Defaults to the brand + page title. */
  imageAlt?: string;
  /** Pixel size of `image`; only the default 1200×630 image is assumed when omitted. */
  imageWidth?: number;
  imageHeight?: number;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  lang?: string;
  appendSiteName?: boolean;
  /** Render the site-wide Organization JSON-LD. The home pages turn this off and emit it inside their own @graph. */
  organizationSchema?: boolean;
}

const detectedLang = getLangFromUrl(Astro.url);

const {
  title,
  description,
  image = SITE.ogImage.path,
  imageAlt,
  imageWidth,
  imageHeight,
  canonicalUrl,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  lang = detectedLang,
  appendSiteName = true,
  organizationSchema = true,
} = Astro.props;

const t = useTranslations(detectedLang);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://musicaldown.se';
const currentUrl = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();
const siteName = SITE.name;
// Don't append the brand when the title already contains it (any spelling).
const hasBrand = /musical(?:ly)?\s?down/i.test(title);
const fullTitle = appendSiteName && !hasBrand ? `${title} | ${siteName}` : title;
const alternateLocales = getAlternateLocales(Astro.url.pathname);

const isDefaultImage = image === SITE.ogImage.path;
const ogWidth = imageWidth ?? (isDefaultImage ? SITE.ogImage.width : undefined);
const ogHeight = imageHeight ?? (isDefaultImage ? SITE.ogImage.height : undefined);
const ogImageAlt =
  imageAlt ?? (isDefaultImage ? `${siteName}: free TikTok video & MP3 downloader` : `${siteName} – ${title}`);

// Site-wide Organization schema (rendered once on every page except the home pages, which add it to their @graph)
const organizationGraph = { nodes: [organizationNode({ siteUrl, description: t('site.description') })] };

// "Switch to Español?" banner (English home page only). Suggests, never redirects.
const bannerCopy = Object.fromEntries(
  Object.entries(BANNER_COPY).filter(([l]) => (ENABLED_LOCALES as readonly string[]).includes(l))
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={currentUrl} />

    <!-- Hreflang tags for i18n (language-only codes; skipped on noindex pages) -->
    {!noindex && alternateLocales.map(({ lang: altLang, href }) => (
      <link
        rel="alternate"
        hreflang={localeMeta[altLang].hreflang}
        href={new URL(href, siteUrl).toString()}
      />
    ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(alternateLocales[0].href, siteUrl).toString()}
      />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
    {ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={localeMeta[detectedLang]?.og ?? 'en_US'} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter (these use name=, not property=) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons: SVG for modern browsers, PNG/ICO fallbacks, 180×180 touch icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <!-- Dark Mode: Inline script to prevent FOUC -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        if (
          theme === 'dark' ||
          (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Language suggestion (English home page only). Never redirects: if /api/geo suggests another
         enabled language, a dismissible "Switch to Español?" banner is shown. Skips crawlers.
         Test with /?geo=ID  /?geo=VN  /?geo=ES -->
    <script is:inline define:vars={{ copy: bannerCopy }}>
      (function () {
        try {
          if (location.pathname !== '/') return;
          if (/bot|crawl|spider|slurp|bingpreview|facebookexternalhit|embedly|lighthouse|pagespeed|headless|preview/i.test(navigator.userAgent || '')) return;
          var cookie = function (name) {
            var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]+)'));
            return m ? decodeURIComponent(m[1]) : null;
          };
          var override = new URLSearchParams(location.search).get('geo');
          if (!override && cookie('lang-banner-dismissed')) return;
          // The visitor explicitly picked English in the language picker: respect it.
          if (!override && cookie('user-locale') === 'en') return;
          var show = function (l) {
            var c = copy[l];
            if (!c || l === 'en') return;
            var init = function () {
              var box = document.getElementById('lang-banner');
              if (!box) return;
              box.setAttribute('aria-label', c.label);
              box.setAttribute('lang', l);
              box.querySelector('[data-q]').textContent = c.question;
              var a = box.querySelector('[data-go]');
              a.textContent = c.action;
              a.setAttribute('href', '/' + l + '/');
              a.setAttribute('hreflang', l);
              a.addEventListener('click', function () {
                document.cookie = 'user-locale=' + l + '; path=/; max-age=31536000; SameSite=Lax';
              });
              var x = box.querySelector('[data-close]');
              x.setAttribute('aria-label', c.dismiss);
              x.addEventListener('click', function () {
                document.cookie = 'lang-banner-dismissed=1; path=/; max-age=2592000; SameSite=Lax';
                box.hidden = true;
              });
              box.hidden = false;
            };
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
            else init();
          };
          fetch('/api/geo' + (override ? '?country=' + encodeURIComponent(override) : ''), { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) { show(d && d.locale); })
            .catch(function () {});
        } catch (e) {}
      })();
    </script>
    <!-- Organization schema (site-wide) -->
    {organizationSchema && <JsonLd type="Graph" data={organizationGraph} />}

    <!-- Slot for page-specific head content (JSON-LD, hreflang, etc.) -->
    <slot name="head" />
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="tVY/t/nGwM/K1XPT1/pq6Q" async></script>
    
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text-primary)] antialiased transition-colors duration-200">
    <!-- Skip to main content (a11y) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white"
    >
      {t('skipToContent')}
    </a>

    <!-- Language suggestion banner: hidden until the inline script above decides to show it. Fixed, so no layout shift. -->
    <div
      id="lang-banner"
      role="region"
      aria-label="Language"
      hidden
      class="[&[hidden]]:hidden fixed bottom-4 left-1/2 z-50 flex w-[calc(100%-2rem)] max-w-md -translate-x-1/2 items-center gap-3 rounded-xl border border-[var(--border)] bg-[var(--bg)] px-4 py-3 text-sm text-[var(--text-primary)] shadow-lg"
    >
      <span data-q class="flex-1 font-medium"></span>
      <a
        data-go
        href="/es/"
        class="rounded-lg bg-[#d90f45] px-3 py-1.5 font-semibold text-white no-underline hover:opacity-90"
      ></a>
      <button
        data-close
        type="button"
        aria-label="Close"
        class="flex h-8 w-8 items-center justify-center rounded-lg text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>