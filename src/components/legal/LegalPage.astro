---
/**
 * LegalPage.astro: DMCA / Disclaimer page template. Content comes from src/i18n/legal-extra.ts.
 *   <LegalPage kind="dmca" />
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { dmca, disclaimer, LEGAL_UPDATED } from '../../i18n/legal-extra';

interface Props {
  kind: 'dmca' | 'disclaimer';
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const doc = (Astro.props.kind === 'dmca' ? dmca : disclaimer)[lang];
const updated = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(
  new Date(`${LEGAL_UPDATED}T00:00:00Z`)
);
---

<BaseLayout title={doc.metaTitle} description={doc.metaDescription} appendSiteName={false}>
  <Header slot="header" />
  <div class="mx-auto max-w-4xl px-6 pt-6">
    <Breadcrumbs items={[{ label: t('nav.home'), href: getLocalizedPath(lang, '/') }, { label: doc.crumb }]} />
  </div>

  <div class="mx-auto max-w-4xl bg-white px-6 py-16 md:py-24">
    <header class="mb-12">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
        {doc.title}
      </h1>
      <p class="mt-4 text-lg text-[var(--text-secondary)]">
        {doc.updatedLabel}: <time datetime={LEGAL_UPDATED}>{updated}</time>
      </p>
    </header>

    <div class="prose prose-lg mx-auto dark:prose-invert prose-a:text-[#d90f45] prose-a:no-underline hover:prose-a:underline">
      <p>{doc.intro}</p>
      {doc.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p?.map((para) => <p>{para}</p>)}
          {s.ul && <ul>{s.ul.map((li) => <li>{li}</li>)}</ul>}
        </>
      ))}
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
