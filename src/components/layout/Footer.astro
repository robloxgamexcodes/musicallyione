      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a
          href={getLocalizedPath(lang, '/')}
          class="inline-flex items-center font-display text-xl font-bold tracking-tight"
          aria-label="MusicallyDown homepage"
        >
          Musically<span class="text-[var(--color-red-600)]">Down</span>
        </a>

        <p class="mt-3 max-w-xs text-sm leading-6 text-[var(--text-tertiary)]">
          Download TikTok videos in MP4 and MP3 without watermark.
          Fast, simple and free.
        </p>
      </div>

      <!-- Navigation columns -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">
            {column.title}
          </h3>

          <ul class="mt-4 space-y-3">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
