
---
/**
 * Footer.astro
 * Responsive localized footer with infinite directory badge carousel
 * and language navigation.
 */

import {
  getLangFromUrl,
  useTranslations,
  getLocalizedPath,
  getAlternateLocales,
} from '../../i18n/utils';

import { languages } from '../../i18n/ui';
import { legalLabels } from '../../i18n/legal-extra';
import { getIntentLabels } from '../../i18n/intent-pages';

