---
/**
 * Footer.astro — Site footer with navigation columns, directory badges and social links
 */
import { getLangFromUrl, useTranslations, getLocalizedPath, getAlternateLocales } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
// Plain <a> links to every language version of this page (crawlable, unlike the <select> picker)
const langLinks = getAlternateLocales(Astro.url.pathname);

import { getIntentLabels, INTENT_SLUGS } from '../../i18n/intent-pages';
const intentLabels = getIntentLabels(lang);
const intentLinks = INTENT_SLUGS.map((s) => ({ label: intentLabels[s], href: getLocalizedPath(lang, `/${s}`) }));

const footerColumns = [
  {
    title: t('footer.product'),
    links: [
      { label: t('nav.home'), href: getLocalizedPath(lang, '/') },
      { label: t('nav.stories'), href: getLocalizedPath(lang, '/download-tiktok-stories') },
      { label: t('nav.mp3'), href: getLocalizedPath(lang, '/tiktok-mp3') },
    ],
  },
  {
    title: t('footer.resources'),
    links: [
      { label: t('nav.blog'), href: getLocalizedPath(lang, '/blog') },
      { label: t('nav.about'), href: getLocalizedPath(lang, '/about') },
      { label: t('nav.x'), href: 'https://t.co/dPzLhVgA0S' },
    ],
  },
  {
    title: t('footer.company'),
    links: [
      { label: t('nav.contact'), href: getLocalizedPath(lang, '/contact') },
      { label: t('footer.privacyPolicy'), href: getLocalizedPath(lang, '/privacy') },
      { label: t('footer.termsOfService'), href: getLocalizedPath(lang, '/terms') },
    ],
  },
];

// Directory / launch badges (rendered in the badge row above the bottom bar)
const badges = [
  {
    name: 'CircleSaaS',
    href: 'https://circlesaasboard.com/startup/musicaldown-a1402d',
    src: 'https://circlesaasboard.com/badge.svg',
    alt: 'Featured on CircleSaaS',
  },
  {
    name: 'forg.to',
    href: 'https://forg.to/projects/musicallydown-7d626823',
    src: 'https://forg.to/api/badges/shipped/musicallydown-7d626823?theme=dark&shape=rounded',
    alt: 'MusicallyDown - Shipped on forg.to',
  },
  {
    name: 'Toolfame',
    href: 'https://toolfame.com/item/musicallydown',
    src: 'https://toolfame.com/badge-light.svg',
    alt: 'Featured on toolfame.com',
  },
  {
    name: 'Fazier',
    href: 'https://fazier.com/launches/musicaldown.se',
    src: 'https://fazier.com/api/v1//public/badges/launch_badges.svg?badge_type=featured&theme=light',
    alt: 'Featured on Fazier',
  },
  // Add more once you've submitted to the directory and have your own slug, e.g.:
  // { name: 'Findly', href: 'https://findly.tools/YOUR-SLUG', src: 'https://findly.tools/badges/findly-tools-badge-light.svg', alt: 'Featured on Findly Tools' },
  // { name: 'SaaSFame', href: 'https://saasfame.com/item/YOUR-SLUG', src: 'https://saasfame.com/badge-light.svg', alt: 'Featured on SaaSFame' },
  // { name: 'AIToolFame', href: 'https://aitoolfame.com/item/YOUR-SLUG', src: 'https://aitoolfame.com/badge-light.svg', alt: 'Featured on AIToolFame' },
  // { name: 'Turbo0', href: 'https://turbo0.com/item/YOUR-SLUG', src: 'https://img.turbo0.com/badge-listed-light.svg', alt: 'Listed on Turbo0' },
  // { name: 'PeerBear', href: 'https://peerbear.io/p/YOUR-SLUG', src: 'https://peerbear.io/badge-light.svg', alt: 'Listed on PeerBear' },
];
---

<footer class="border-t border-[var(--border)] bg-white">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a href={getLocalizedPath(lang, '/')} class="flex items-center gap-2 font-display text-lg font-bold">
          <span class="font-display text-xl font-bold tracking-tight">Musically<span class="text-[var(--color-red-600)] dark:text-[var(--color-primary-400)]">Down</span></span>
        </a>
      </div>

      <!-- Navigation columns -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{column.title}</h3>
          <ul class="mt-3 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  {...(link.href.startsWith('http') && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Directory badges -->
    <div class="mt-12 flex justify-center" role="group" aria-label="Featured on">
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-4">
        {badges.map((badge) => (
          <li class="flex items-center">
            <a
              href={badge.href}
              target="_blank"
              rel="noopener"
              title={badge.name}
              class="inline-flex opacity-80 transition duration-200 hover:-translate-y-0.5 hover:opacity-100"
            >
              <img
                src={badge.src}
                alt={badge.alt}
                width="60"
                height="18"
                loading="lazy"
                decoding="async"
                class="h-[18px] w-[60px] object-contain"
              />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border)] pt-8 text-sm text-[var(--text-tertiary)] md:flex-row">
      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
        <p>
          &copy; {currentYear} <span set:html={t('footer.copyright')} />
        <p>
        <nav aria-label={t('footer.languages')}>
          <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
            {langLinks.map(({ lang: l, href }) => (
              <li>
                <a
                  href={href}
                  lang={l}
                  hreflang={l}
                  data-lang-link={l}
                  class:list={[
                    'transition-colors hover:text-[var(--text-primary)]',
                    l === lang && 'font-semibold text-[var(--text-primary)]',
                  ]}
                  aria-current={l === lang ? 'true' : undefined}
                >
                  {languages[l]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<script>
  // Remember an explicit language choice (same cookie as the language picker)
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach((a) => {
    a.addEventListener('click', () => {
      document.cookie = `user-locale=${a.dataset.langLink}; path=/; max-age=31536000; SameSite=Lax`;
    });
  });
</script>