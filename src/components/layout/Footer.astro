
---
/**
 * Footer.astro
 * Responsive localized footer with directory badges and language navigation.
 */

import {
  getLangFromUrl,
  useTranslations,
  getLocalizedPath,
  getAlternateLocales,
} from '../../i18n/utils';

import { languages } from '../../i18n/ui';
import { legalLabels } from '../../i18n/legal-extra';
import { getIntentLabels, INTENT_SLUGS } from '../../i18n/intent-pages';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const langLinks = getAlternateLocales(Astro.url.pathname);

const intentLabels = getIntentLabels(lang);

const intentLinks = INTENT_SLUGS.map((slug) => ({
  label: intentLabels[slug],
  href: getLocalizedPath(lang, `/${slug}`),
}));

// Footer navigation
const footerColumns = [
  {
    title: t('footer.product'),
    links: [
      { label: t('nav.home'), href: getLocalizedPath(lang, '/') },
      { label: t('nav.stories'), href: getLocalizedPath(lang, '/download-tiktok-stories') },
      { label: t('nav.mp3'), href: getLocalizedPath(lang, '/tiktok-mp3') },
    ],
  },
  {
    title: t('footer.resources'),
    links: [
      { label: t('nav.blog'), href: getLocalizedPath(lang, '/blog') },
      { label: t('nav.about'), href: getLocalizedPath(lang, '/about') },
      { label: t('nav.x'), href: 'https://t.co/dPzLhVgA0S' },
    ],
  },
  {
    title: t('footer.company'),
    links: [
      { label: t('nav.contact'), href: getLocalizedPath(lang, '/contact') },
      { label: t('footer.privacyPolicy'), href: getLocalizedPath(lang, '/privacy') },
      { label: t('footer.termsOfService'), href: getLocalizedPath(lang, '/terms') },
      { label: legalLabels[lang].dmca, href: getLocalizedPath(lang, '/dmca') },
      { label: legalLabels[lang].disclaimer, href: getLocalizedPath(lang, '/disclaimer') },
    ],
  },
];

// Official directory listing pages and their supplied badge image endpoints
const badges = [
  {
    name: 'CircleSaaS',
    href: 'https://circlesaasboard.com/startup/musicaldown-a1402d',
    src: 'https://circlesaasboard.com/badge.svg',
    alt: 'MusicallyDown featured on CircleSaaS',
    width: 120,
    height: 36,
  },
  {
    name: 'Forg',
    href: 'https://forg.to/projects/musicallydown-7d626823',
    src: 'https://forg.to/api/badges/shipped/musicallydown-7d626823?theme=dark&shape=rounded',
    alt: 'MusicallyDown shipped on Forg',
    width: 120,
    height: 36,
  },
  {
    name: 'Toolfame',
    href: 'https://toolfame.com/item/musicallydown',
    src: 'https://toolfame.com/badge-light.svg',
    alt: 'MusicallyDown featured on Toolfame',
    width: 120,
    height: 36,
  },
  {
    name: 'Fazier',
    href: 'https://fazier.com/launches/musicaldown.se',
    src: 'https://fazier.com/api/v1/public/badges/launch_badges.svg?badge_type=featured&theme=light',
    alt: 'MusicallyDown featured on Fazier',
    width: 120,
    height: 36,
  },
  {
    name: 'Aidirs',
    href: 'https://aidirs.best/item/musically-down',
    src: 'https://aidirs.best/light.svg',
    alt: 'MusicallyDown - TikTok Video Downloader | Aidirs',
    width: 120,
    height: 36,
  },
];
---

<footer class="border-t border-[var(--border)] bg-white dark:bg-gray-950">

  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">

    <!-- Main footer -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a
          href={getLocalizedPath(lang, '/')}
          class="inline-flex items-center font-display text-xl font-bold tracking-tight"
          aria-label="MusicallyDown homepage"
        >
          Musically<span class="text-[var(--color-red-600)]">Down</span>
        </a>

        <p class="mt-3 max-w-xs text-sm leading-6 text-[var(--text-tertiary)]">
          Download TikTok videos in MP4 and MP3 without watermark.
          Fast, simple and free.
        </p>
      </div>

      <!-- Navigation columns -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">
            {column.title}
          </h3>

          <ul class="mt-4 space-y-3">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  {...(link.href.startsWith('http') && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- Directory badges -->
    <div class="mt-12 border-t border-[var(--border)] pt-8">

      <h3 class="mb-6 text-center text-sm font-semibold text-[var(--text-primary)]">
        Featured on
      </h3>

      <ul
        class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6"
        role="list"
        aria-label="MusicallyDown directory listings"
      >
        {badges.map((badge) => (
          <li class="flex items-center justify-center">
            <a
              href={badge.href}
              target="_blank"
              rel="nofollow noopener noreferrer"
              title={badge.name}
              aria-label={`View MusicallyDown on ${badge.name}`}
              class="inline-flex items-center justify-center opacity-85 transition duration-200 hover:-translate-y-1 hover:opacity-100"
            >
              <img
                src={badge.src}
                alt={badge.alt}
                width={badge.width}
                height={badge.height}
                loading="lazy"
                decoding="async"
                class="max-h-14 max-w-[200px] object-contain"
              />
            </a>
          </li>
        ))}
      </ul>

    </div>

    <!-- Bottom bar -->
    <div class="mt-10 flex flex-col items-center justify-between gap-5 border-t border-[var(--border)] pt-8 text-sm text-[var(--text-tertiary)] md:flex-row">

      <!-- Copyright -->
      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">

        <p>
          &copy; {currentYear}
          <span set:html={t('footer.copyright')} />
        </p>

        <!-- Language navigation -->
        <nav aria-label={t('footer.languages')}>
          <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
            {langLinks.map(({ lang: locale, href }) => (
              <li>
                <a
                  href={href}
                  lang={locale}
                  hreflang={locale}
                  data-lang-link={locale}
                  class:list={[
                    'transition-colors hover:text-[var(--text-primary)]',
                    locale === lang && 'font-semibold text-[var(--text-primary)]',
                  ]}
                  aria-current={locale === lang ? 'page' : undefined}
                >
                  {languages[locale]}
                </a>
              </li>
            ))}
          </ul>
        </nav>

      </div>

    </div>

  </div>
</footer>

<script>
  // Remember the visitor's explicit language selection
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach((anchor) => {
    anchor.addEventListener('click', () => {
      const selectedLanguage = anchor.dataset.langLink;

      if (selectedLanguage) {
        document.cookie =
          `user-locale=${selectedLanguage}; path=/; max-age=31536000; SameSite=Lax`;
      }
    });
  });
</script>
