<!-- Language preference script -->
<script>
  // Remember the visitor's explicit language selection
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach((anchor) => {
    anchor.addEventListener('click', () => {
      const selectedLanguage = anchor.dataset.langLink;

      if (selectedLanguage) {
        document.cookie =
          `user-locale=${selectedLanguage}; path=/; max-age=31536000; SameSite=Lax`;
      }
    });
  });
</script>

<!-- Infinite badge carousel styles -->
<style>
  /* Carousel viewport */
  .badge-carousel {
    display: block;
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
  }

  /* Two identical groups travel together for a seamless loop */
  .badge-carousel-track {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    max-width: none;
    animation: badge-scroll 36s linear infinite !important;
    animation-play-state: running;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .badge-carousel-group {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    align-items: center;
    gap: 32px;
    padding: 0 32px 0 0;
    margin: 0;
    list-style: none;
  }

  .badge-carousel-group li {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
  }

  .badge-carousel-group a {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .badge-carousel-group a:hover {
    opacity: 0.7;
  }

  .badge-carousel-group img {
    display: block;
    flex: 0 0 auto;
    width: 120px;
    height: 36px;
    object-fit: contain;
  }

  /* Move exactly one badge group width, then repeat seamlessly */
  @keyframes badge-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Pause only while the visitor interacts with the carousel */
  .badge-carousel:hover .badge-carousel-track,
  .badge-carousel:focus-within .badge-carousel-track {
    animation-play-state: paused !important;
  }

  @media (max-width: 640px) {
    .badge-carousel-group {
      gap: 24px;
      padding-right: 24px;
    }

    .badge-carousel-group img {
      width: 110px;
      height: 34px;
    }

    .badge-carousel-track {
      animation-duration: 30s !important;
    }
  }
</style>
