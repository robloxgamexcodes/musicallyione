---
/**
 * JsonLd.astro — Dynamic JSON-LD Schema.org Generator
 *
 * Supports multiple schema types:
 * - Graph (several linked nodes with @id, see src/lib/schema.ts)  <- home page
 * - WebSite
 * - WebApplication (the downloader tool)
 * - BlogPosting / Article
 * - Organization
 * - Person (for E-E-A-T author profiles)
 * - FAQPage
 * (BreadcrumbList is emitted by components/seo/Breadcrumbs.astro.)
 *
 * No SearchAction: Google retired the sitelinks search box and the site has no /search page.
 * No AggregateRating / Review: never add self-served ratings.
 *
 * Usage:
 *   <JsonLd type="Graph" data={{ nodes: [organizationNode(...), webSiteNode(...)] }} />
 *   <JsonLd type="BlogPosting" data={{ headline: "...", ... }} />
 */
import { graph, webSiteNode, webApplicationNode } from '../../lib/schema';

export interface WebSiteData {
  siteUrl: string;
  lang: string;
  description?: string;
}

export interface WebApplicationData {
  siteUrl: string;
  lang: string;
  description?: string;
}

export interface GraphData {
  nodes: Record<string, unknown>[];
}

export interface BlogPostingData {
  headline: string;
  description: string;
  url: string;
  datePublished: string;
  dateModified?: string;
  image?: string;
  inLanguage?: string;
  author: {
    type?: 'Person' | 'Organization';
    id?: string;
    name: string;
    url?: string;
  };
  publisher?: {
    id?: string;
    name: string;
    logo?: string;
  };
}

export interface OrganizationData {
  name: string;
  url: string;
  logo?: string;
  description?: string;
  sameAs?: string[];
  contactPoint?: Record<string, unknown>;
}

export interface PersonData {
  /** Stable @id so BlogPosting.author can point at this Person node. */
  id?: string;
  /** @id of the employer Organization. */
  worksFor?: string;
  name: string;
  url?: string;
  jobTitle?: string;
  description?: string;
  image?: string;
  sameAs?: string[];
}

export interface FAQItem {
  question: string;
  answer: string;
}

export interface FAQPageData {
  items: FAQItem[];
}

type SchemaType =
  | 'Graph'
  | 'WebSite'
  | 'WebApplication'
  | 'BlogPosting'
  | 'Organization'
  | 'Person'
  | 'FAQPage';

interface Props {
  type: SchemaType;
  data:
    | GraphData
    | WebSiteData
    | WebApplicationData
    | BlogPostingData
    | OrganizationData
    | PersonData
    | FAQPageData;
}

const { type, data } = Astro.props;

function buildSchema(type: SchemaType, data: any): Record<string, unknown> {
  switch (type) {
    case 'Graph': {
      return graph((data as GraphData).nodes);
    }

    case 'WebSite': {
      const d = data as WebSiteData;
      return { '@context': 'https://schema.org', ...webSiteNode(d) };
    }

    case 'WebApplication': {
      const d = data as WebApplicationData;
      return { '@context': 'https://schema.org', ...webApplicationNode(d) };
    }

    case 'BlogPosting': {
      const d = data as BlogPostingData;
      const schema: Record<string, unknown> = {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: d.headline,
        description: d.description,
        url: d.url,
        datePublished: d.datePublished,
        mainEntityOfPage: { '@type': 'WebPage', '@id': d.url },
        author: {
          '@type': d.author.type ?? 'Person',
          ...(d.author.id && { '@id': d.author.id }),
          name: d.author.name,
          ...(d.author.url && { url: d.author.url }),
        },
      };
      if (d.inLanguage) schema.inLanguage = d.inLanguage;
      if (d.dateModified) schema.dateModified = d.dateModified;
      if (d.image) schema.image = d.image;
      if (d.publisher) {
        schema.publisher = {
          '@type': 'Organization',
          ...(d.publisher.id && { '@id': d.publisher.id }),
          name: d.publisher.name,
          ...(d.publisher.logo && {
            logo: { '@type': 'ImageObject', url: d.publisher.logo },
          }),
        };
      }
      return schema;
    }

    case 'Organization': {
      const d = data as OrganizationData;
      const schema: Record<string, unknown> = {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: d.name,
        url: d.url,
      };
      if (d.logo) schema.logo = { '@type': 'ImageObject', url: d.logo };
      if (d.description) schema.description = d.description;
      if (d.sameAs?.length) schema.sameAs = d.sameAs;
      if (d.contactPoint) schema.contactPoint = d.contactPoint;
      return schema;
    }

    case 'Person': {
      const d = data as PersonData;
      const schema: Record<string, unknown> = {
        '@context': 'https://schema.org',
        '@type': 'Person',
        ...(d.id && { '@id': d.id }),
        name: d.name,
      };
      if (d.worksFor) schema.worksFor = { '@type': 'Organization', '@id': d.worksFor };
      if (d.url) schema.url = d.url;
      if (d.jobTitle) schema.jobTitle = d.jobTitle;
      if (d.description) schema.description = d.description;
      if (d.image) schema.image = d.image;
      if (d.sameAs?.length) schema.sameAs = d.sameAs;
      return schema;
    }

    case 'FAQPage': {
      const d = data as FAQPageData;
      return {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.items.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      };
    }
  }
}

const schema = buildSchema(type, data);
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema, null, 2)}></script>
