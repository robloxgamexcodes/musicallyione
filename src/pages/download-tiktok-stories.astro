---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { pageBadges } from '../i18n/page-badges';
import HeroSection from '../components/marketing/HeroSection.astro';
import StoriesArticle from '../components/marketing/StoriesArticle.astro';
import { getStoriesContent } from '../i18n/ui';

// All text lives in STORIES_PAGE (en) in src/i18n/ui.ts
const c = getStoriesContent('en');
---
<BaseLayout title={c.metaTitle} description={c.metaDescription}>
  <Header slot="header" />
  <HeroSection
    badges={pageBadges['en'].stories}
    titleStart={c.heroTitleStart}
    titleHighlight={c.heroTitleHighlight}
    description={c.heroDescription}
  />
  <StoriesArticle />
  <Footer slot="footer" />
</BaseLayout>
