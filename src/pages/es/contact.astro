---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import PageCrumbs from '../../components/seo/PageCrumbs.astro';
import Footer from '../../components/layout/Footer.astro';
---

<BaseLayout
  title="Contacto"
  description="¿Dudas o problemas técnicos? Contacta con el soporte de MusicallyDown en support@musicaldown.se. Incluye el enlace afectado y nunca compartas tu contraseña."
>
  <Header slot="header" />
  <PageCrumbs page="contact" />

  <div class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <article class="prose prose-zinc prose-lg mx-auto dark:prose-invert prose-a:text-[#d90f45] prose-a:no-underline hover:prose-a:underline">
      <h1>Contacto</h1>
      <p>
        ¿Tienes una pregunta, un error que informar o una solicitud de retirada? Escríbenos e
        incluye el enlace de TikTok que causó el problema. Por favor, nunca envíes tu contraseña de
        TikTok ni otros datos personales.
      </p>
      <h2>Soporte</h2>
      <p>
        Escríbenos a <a href="mailto:support@musicaldown.se">support@musicaldown.se</a>. Leemos
        todos los mensajes y respondemos en un plazo de 2 a 3 días hábiles.
      </p>
      <p>
        <a href="/es/">Volver al inicio</a>
      </p>
    </article>
  </div>

  <Footer slot="footer" />
</BaseLayout>
