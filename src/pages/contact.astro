---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import PageCrumbs from '../components/seo/PageCrumbs.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout
  title="Contact Us"
  description="Questions or technical problems? Contact MusicallyDown support at support@musicaldown.se. Include the problem link, never your password or personal details."
>
  <Header slot="header" />
  <PageCrumbs page="contact" />

  <div class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <article class="prose prose-zinc prose-lg mx-auto dark:prose-invert prose-a:text-[#d90f45] prose-a:no-underline hover:prose-a:underline">
      <h1>Contact Us</h1>
      <p>
        Have a question, a bug to report or a removal request? Send us a message and include the
        TikTok link that caused the problem. Please never send your TikTok password or other
        personal information.
      </p>
      <h2>Support</h2>
      <p>
        Email us at <a href="mailto:support@musicaldown.se">support@musicaldown.se</a>. We read
        every message and aim to reply within 2–3 business days.
      </p>
      <p>
        <a href="/">Back to home</a>
      </p>
    </article>
  </div>

  <Footer slot="footer" />
</BaseLayout>
